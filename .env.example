# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the saepudinasep2001_db_user
# one found in a remote Prisma Postgres URL, does not contain any sensitive information. oZ3MkDMpzEq7Avo6

DATABASE_URL=""

# Auth.js v5: buat dengan `npx auth secret` atau `openssl rand -base64 32`
AUTH_SECRET=""

# Cloudinary (dipakai pada tahap upload foto)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Opsional: password awal untuk seed (hanya dev/demo)
SEED_DEFAULT_PASSWORD="smk12345"
SEED_ADMIN_PASSWORD="admin1234"

# --- Pengaman seed (HANYA di .env lokal, jangan diisi di Vercel/produksi) ---
# Seed MENGHAPUS semua data di database tujuan. Tanpa baris ini seed menolak berjalan.
SEED_ALLOW_WIPE=""

# --- Admin pertama untuk produksi (npm run db:create-admin) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""   # min. 8 karakter: huruf besar, kecil, angka, simbol
ADMIN_EMAIL=""
